{
  "name": "paperclip-plugin-org-accent",
  "version": "0.3.2",
  "type": "module",
  "private": true,
  "description": "Tints the whole Paperclip UI in a per-company accent color",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "ui"
  ],
  "author": "traste",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0",
    "@paperclipai/shared": "2026.1012.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrasteCC/paperclip-plugin-org-accent.git"
  }
}
